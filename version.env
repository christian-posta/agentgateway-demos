# Standalone OSS agentgateway version.
# Sourced by ./run-compose.sh (as docker compose --env-file) and run-proxy-local.sh.
#
# NOTE: the leading "v" is mandatory. Tags without it (e.g. 1.5.0) do not exist
# in either registry.
AGW_VERSION=v1.5.0

# Image registry. Both of these publish the same tags:
#   cr.agentgateway.dev/agentgateway        (what upstream docs use)
#   ghcr.io/agentgateway/agentgateway
AGW_IMAGE_REPO=cr.agentgateway.dev/agentgateway
