# Enterprise Agentgateway Helm chart version (CRDs + controller).
# Sourced by setup-gateway.sh, setup-obo.sh, and setup-msft-obo.sh after .env.
ENTERPRISE_AGW_VERSION=v2026.5.2

# Chart registry. GA releases (e.g. v2026.5.2) live in the public repo below.
# For dev nightlies (e.g. v2026.5.0-beta.4-nightly-2026-05-11), override with:
#   ENTERPRISE_AGW_CHART_REPO=oci://us-central1-docker.pkg.dev/developers-369321/enterprise-agentgateway-dev/charts
ENTERPRISE_AGW_CHART_REPO=${ENTERPRISE_AGW_CHART_REPO:-oci://us-docker.pkg.dev/solo-public/enterprise-agentgateway/charts}
